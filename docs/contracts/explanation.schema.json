{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExplanationContract",
  "description": "LLM explanation output for a recommended inventory action",
  "type": "object",
  "required": [
    "sku",
    "text",
    "source",
    "numbers_check_passed"
  ],
  "properties": {
    "sku": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "live",
        "saved"
      ]
    },
    "numbers_check_passed": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
